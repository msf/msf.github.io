# shellcheck shell=sh
# Framework 13 reference machine for local-LLM work.
# Source this file from shell scripts that need the real runtime paths/defaults
# for this box. Update SHAs after explicit refresh checks.

MACHINE_ID="framework13"
MACHINE_HOSTNAME="fw13"
MACHINE_LABEL="Framework 13 / Ryzen AI 9 HX 370 / Radeon 890M / 64GB"
MACHINE_OS="Ubuntu 24.04.4 LTS"
MACHINE_KERNEL="6.17.0-20-generic"

CPU_MODEL="AMD Ryzen AI 9 HX 370"
GPU_MODEL="AMD Radeon 890M"
RAM_GB="64"
MEMORY_BANDWIDTH_GBPS="89.6"

LAB_ROOT="${HOME}/play/msf.github.io/blogpost/benchmarking_llms"
MACHINES_DIR="${LAB_ROOT}/machines"
BENCH_DIR="${LAB_ROOT}/bench"
RESULTS_DIR="${LAB_ROOT}/artifacts/results"
LOGS_DIR="${LAB_ROOT}/artifacts/logs"
HISTORY_DIR="${LAB_ROOT}/artifacts/history"

LLAMA_HOME="${HOME}/play/llama"
LLAMA_RELEASE="llama-b8708"
LLAMA_CURRENT="${LLAMA_HOME}/llama-current"
LLAMA_CLI="${LLAMA_CURRENT}/llama-cli"
LLAMA_SERVER="${LLAMA_CURRENT}/llama-server"
LLAMA_SWAP="${LLAMA_HOME}/llama-swap"
LLAMA_SWAP_CONFIG="${LLAMA_HOME}/config.yaml"
LLAMA_SWAP_ENDPOINT="http://localhost:8080"

HF_HUB_ROOT="/mnt/ai-models/huggingface/hub"
GGUF_CACHE_ROOT="/mnt/ai-models/gguf-models"

SERVING_BACKEND="vulkan"
SERVING_FLASH_ATTN="on"
SERVING_GPU_LAYERS="99"
SERVING_CACHE_TYPE_K="q8_0"
SERVING_CACHE_TYPE_V="q8_0"
SERVING_HEALTHCHECK_TIMEOUT_S="300"

BENCHMARK_POWER_PROFILE="power-saver"
BENCHMARK_SEEDS="42 123 456"
BENCHMARK_DEFAULT_TIMEOUT="10m"
BENCHMARK_EXAM_V3_MAX_TOKENS="8192"
BENCHMARK_DEFAULT_SWEEP_SCRIPT="${LAB_ROOT}/scripts/sweep-exam3.sh"

PRIMARY_MODEL_ALIAS="gemma4-26b-mxfp4-64k"
THINKING_MODEL_ALIAS="qwen36-35b-q5km-thinkon"
FAST_QWEN_ALIAS="qwen36-35b-q5km-thinkoff"
LEGACY_VALUE_REFERENCE_ALIAS="gpt-oss"
USER_EXCLUDED_SWEEP_MODELS="gpt-oss"

QWEN36_REPO="unsloth/Qwen3.6-35B-A3B-GGUF"
QWEN36_LOCAL_SHA="9280dd353ab587157920d5bd391ada414d84e552"
QWEN36_REMOTE_SHA_AS_OF_2026_04_23="a483e9e6cbd595906af30beda3187c2663a1118c"

